# Set default behavior to automatic text line ending normalization.
* text=auto

# Force LF line endings for scripts
*.sh text eol=lf
gradlew text eol=lf

# Force CRLF line endings for Windows batch files
*.bat text eol=crlf

# Explicitly declare binary files to prevent corruption on transfer/git
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary
