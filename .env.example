# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIRECRAWL_API_KEY: Optional API key for Firecrawl v2 live web, news, and image search + markdown scraping.
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=""

# GROQ_API_KEY: Optional API key for Groq low-latency LLM streaming (moonshotai/kimi-k2-instruct).
# Get a key at https://groq.com
GROQ_API_KEY=""

# SEARXNG_URL: Optional base URL for a self-hosted or custom SearXNG instance (e.g., http://localhost:8080 or https://searx.be).
# When left blank, the server automatically rotates through public SearXNG instances and open metasearch APIs ($0 budget fallback).
SEARXNG_URL=""

# SEARXNG_API_KEY: Optional API key or Authorization token if your SearXNG instance or proxy requires authentication.
SEARXNG_API_KEY=""


